"ask.detail.focus_title" = "このページで先に見るもの";
"ask.detail.steps_title" = "四つの手順";
"ask.detail.steps_subtitle" = "観察を順番に分け、一目で決めつけない。";
"ask.love.step.1.title" = "位置を探す";
"ask.love.step.1.body" = "感情線が指の付け根下にあるか、関係短線が小指下の側面にある短い横線かを確認する。";
"ask.love.step.2.title" = "終点を見る";
"ask.love.step.2.body" = "感情線の終点が人差し指、中指、小指側のどこへ向くかで関係基準の読みが変わる。";
"ask.love.step.3.title" = "連続性を見る";
"ask.love.step.3.body" = "鎖状、切れ、島紋は細かな皮膚線と区別し、拡大図で確認する。";
"ask.love.step.4.title" = "関係リズムを合わせる";
"ask.love.step.4.body" = "関係短線は親密さのリズムを補うだけで、関係回数の単独判断にしない。";
"ask.thinking.step.1.title" = "主線を確認";
"ask.thinking.step.1.body" = "知能線は親指と人差し指の間から手のひらへ入り、通常は感情線の下にある。";
"ask.thinking.step.2.title" = "方向を見る";
"ask.thinking.step.2.body" = "まっすぐなら論理寄り、下がるなら想像寄り、分岐は表現の切り替えを見る。";
"ask.thinking.step.3.title" = "起点を見る";
"ask.thinking.step.3.body" = "生命線と同じ起点か離れるかは、慎重さや独立感を見る補助になる。";
"ask.thinking.step.4.title" = "干渉を見る";
"ask.thinking.step.4.body" = "横切る線、島紋、細かな支線は段階的な干渉として扱い、主線判断を覆さない。";
"ask.action.step.1.title" = "縦線を探す";
"ask.action.step.1.body" = "手の中央から中指へ上がる仕事線を探し、次に薬指下の太陽線を見る。";
"ask.action.step.2.title" = "起点を見る";
"ask.action.step.2.body" = "仕事線が手首、月丘、生命線付近のどこから始まるかで道筋の由来を見る。";
"ask.action.step.3.title" = "段階を見る";
"ask.action.step.3.body" = "上下で深さが違う場合、方向感が強まる時期や転換点を記録する。";
"ask.action.step.4.title" = "表現を見る";
"ask.action.step.4.body" = "太陽線は作品性、審美、見られ方を補う線で、仕事線の代わりではない。";
"ask.rhythm.step.1.title" = "弧を見る";
"ask.rhythm.step.1.body" = "生命線の弧が開くほど、行動空間や体力の使い方を重視して読む。";
"ask.rhythm.step.2.title" = "深さを見る";
"ask.rhythm.step.2.body" = "線の深さと色は自然光で観察し、最近の生活リズムと合わせて記録する。";
"ask.rhythm.step.3.title" = "雑線を見る";
"ask.rhythm.step.3.body" = "細かな線が多いときは段階的な負荷を先に考え、長期結論にしない。";
"ask.rhythm.step.4.title" = "再確認する";
"ask.rhythm.step.4.body" = "同じ光で一週間後に撮り直し、一回の判断より変化を重視する。";

"learn.title" = "七日で手相を学ぶ";
"learn.subtitle" = "毎日三枚の図で、定位から組み合わせ判断へ進む";
"learn.guide.title" = "まず図を見て、次に読み方を確認する";
"learn.guide.body" = "学習路では重要な観察動作だけを扱う。対応図で位置を確認し、目標と練習で再確認する。一本の線だけで断定しない。";
"learn.seven_day.title" = "七日識掌";
"learn.seven_day.subtitle" = "主線、変化、関係、評価線を段階的に学ぶ。";
"learn.library.title" = "蔵書閣";
"learn.library.subtitle" = "線法、掌丘、記号、問いの道筋をまとめて収蔵。";
"learn.day.1.title" = "1日目 · 三線の定位";
"learn.day.1.body" = "生命線、知能線、感情線の三本だけを探し、写真に印をつける。";
"learn.day.2.title" = "2日目 · 生命線の弧";
"learn.day.2.body" = "生命線の弧、深さ、連続性を比較し、長短だけで生命长度を判断しない。";
"learn.day.3.title" = "3日目 · 知能線の方向";
"learn.day.3.body" = "知能線が掌心に入った後の方向を観察し、直線、下垂、末端分岐を記録する。";
"learn.day.4.title" = "4日目 · 感情線の分型";
"learn.day.4.body" = "感情線の終点と線体状態を観察し、局所的なしわを完全な型と見なさない。";
"learn.day.5.title" = "5日目 · 仕事線の段階";
"learn.day.5.body" = "仕事線の起点と連続性を確認し、仕事のリズムに出る段階変化を記録する。";
"learn.day.6.title" = "6日目 · 関係短線の境界";
"learn.day.6.body" = "関係短線が小指下の掌側にあることを確認し、深さ、方向、主従を見る。";
"learn.day.7.title" = "7日目 · 組み合わせ復習";
"learn.day.7.body" = "一組の図で総合復習し、位置、変化、組み合わせ、保留判断を書く。";

