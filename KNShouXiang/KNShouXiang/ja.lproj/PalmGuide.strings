"compass.signs.item.3.title" = "島紋";
"compass.signs.item.3.body" = "線が小さな輪を作る形。ある時期の滞りや力の分散として読む。";
"compass.signs.item.4.title" = "三角紋";
"compass.signs.item.4.body" = "三つの線が明瞭に閉じる形。能力構造や資源の集まりを補助的に見る。";
"compass.rhythm.title" = "色 · リズム観察";
