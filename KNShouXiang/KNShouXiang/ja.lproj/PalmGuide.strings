"line.life.title" = "生命線";
"line.life.subtitle" = "活力と生活リズムを見る";
"line.life.summary" = "親指の付け根を囲むように手首へ下がる線。体力の余裕、回復のリズム、生活の安定感を観察する。";
"line.life.observation" = "金星丘を包む弧の大きさ、線の深さ、連続性、終点の向きを見る。長さだけで生命长度を判断しない。";
"line.life.traditional_meaning" = "伝統的な手相では、生命線は体力、行動力、生活の土台を表す。深く明瞭なら気力が安定し、途切れや細さは生活リズムの乱れを示すことがある。";
"line.life.confusion" = "生命線は知能線の起点と重なりやすい。まず親指と人差し指の間から出る弧状の主線を確認する。";
"line.life.tags" = "弧|深さ|途切れ|終点";
"line.life.variant.1.title" = "深く長く明瞭";
"line.life.variant.1.meaning" = "体力が安定し、物事を続ける力がある。";
"line.life.variant.1.observation" = "線がはっきりし、大きな切れ目がなく、自然な弧で親指の付け根を包む。";
"line.life.variant.2.title" = "親指に近い";
"line.life.variant.2.meaning" = "慎重で、体力の使い方が保守的。";
"line.life.variant.2.observation" = "弧が狭く、金星丘の面積が小さく見える。";
"line.life.variant.3.title" = "中ほどで途切れる";
"line.life.variant.3.meaning" = "時期による負荷や生活リズムの変化が出やすい。";
"line.life.variant.3.observation" = "細かい皮膚のしわを断線と混同せず、左右の手も比べる。";
"line.life.variant.4.title" = "終点が分かれる";
"line.life.variant.4.meaning" = "後年の活動範囲、住環境、生活の重点が増える可能性。";
"line.life.variant.4.observation" = "分岐が明瞭か、月丘方向へ伸びるかを確認する。";

"line.head.title" = "知能線";
"line.head.subtitle" = "考え方を見る";
"line.head.summary" = "親指と人差し指の間から手のひらを横切る線。分析習慣、学び方、判断スタイルを見る。";
"line.head.observation" = "感情線の下にあることを確認し、まっすぐか、下がるか、分岐するかを見る。";
"line.head.traditional_meaning" = "知能線が明瞭で安定していれば考えが整理されやすい。下向きに伸びる場合は想像力や感受性が強いと読む。";
"line.head.confusion" = "生命線と同じ起点でも離れていてもよい。大事なのは手のひらに入った後の方向。";
"line.head.tags" = "方向|長さ|起点|分岐";
"line.head.variant.1.title" = "まっすぐ強い";
"line.head.variant.1.meaning" = "論理と事実を重視し、規則が明確な作業に向く。";
"line.head.variant.1.observation" = "横方向に安定し、終点が大きく下がらない。";
"line.head.variant.2.title" = "はっきり下がる";
"line.head.variant.2.meaning" = "想像力が強く、状況や感情に反応しやすい。";
"line.head.variant.2.observation" = "終点が月丘方向へ向かう。細かな支線と区別する。";
"line.head.variant.3.title" = "起点が離れる";
"line.head.variant.3.meaning" = "独立性が強く、決断が早い。";
"line.head.variant.3.observation" = "知能線と生命線の始まりに明確な隙間がある。";
"line.head.variant.4.title" = "終点が分かれる";
"line.head.variant.4.meaning" = "理性と表現を切り替えやすい。";
"line.head.variant.4.observation" = "終点が二股になり、一方が横へ、一方がやや下へ向かう。";

"line.heart.title" = "感情線";
"line.heart.subtitle" = "感情表現を見る";
"line.heart.summary" = "指の付け根の下を横に走る線。感情表現、親密さの基準、共感の仕方を観察する。";
"line.heart.observation" = "上掌部を安定して横切るか、始点と終点、弧、鎖状、分岐を見る。";
"line.heart.traditional_meaning" = "感情線が明瞭で弧を描く場合、感情表現が安定していると読む。鎖状で細かい場合は敏感さを示すことがある。";
"line.heart.confusion" = "指の付け根の横じわを感情線と見間違えない。感情線は手のひら上部にある主線。";
"line.heart.tags" = "起点|弧|鎖状|分岐";
"line.heart.variant.1.title" = "人差し指下まで長い";
"line.heart.variant.1.meaning" = "理想を重視し、関係では約束と価値観の一致を大切にする。";
"line.heart.variant.1.observation" = "終点が人差し指下へ伸び、線が明瞭。";
"line.heart.variant.2.title" = "中指下で止まる";
"line.heart.variant.2.meaning" = "現実的で抑制的、表現は控えめ。";
"line.heart.variant.2.observation" = "終点が手の外へ出ず、中指下付近で止まる。";
"line.heart.variant.3.title" = "鎖状で細かい";
"line.heart.variant.3.meaning" = "感情が繊細で、場の雰囲気に影響されやすい。";
"line.heart.variant.3.observation" = "一本の滑らかな線ではなく、小さな連なりでできている。";
"line.heart.variant.4.title" = "終点が分かれる";
"line.heart.variant.4.meaning" = "表現が多面的で、理性と感情の切り替えができる。";
"line.heart.variant.4.observation" = "分岐が明瞭かを確認し、雑線と混同しない。";

"line.career.title" = "仕事線";
"line.career.subtitle" = "目標の道筋を見る";
"line.career.summary" = "手のひら下部から中指方向へ上がる線。目標感、仕事の段階、責任の変化を観察する。";
"line.career.observation" = "手の中央を通る縦線があるか、起点が手首、月丘、生命線付近のどこかを見る。";
"line.career.traditional_meaning" = "仕事線が明瞭なら目標が続き責任感が強いと読む。後から濃くなる線や途切れは段階的な転換を示す。";
"line.career.confusion" = "仕事線は誰にでもはっきり出るわけではない。薄いから仕事運が悪いとは限らない。";
"line.career.tags" = "起点|連続性|深さ|段階";
"line.career.variant.1.title" = "中指へまっすぐ";
"line.career.variant.1.meaning" = "目標が安定し、長期的な積み上げを重視する。";
"line.career.variant.1.observation" = "手の中央軸に近く、上向きの方向が明確。";
"line.career.variant.2.title" = "中年以降に濃い";
"line.career.variant.2.meaning" = "方向性が後から定まり、後半に強くなる。";
"line.career.variant.2.observation" = "下部が薄く、上部が深い。";
"line.career.variant.3.title" = "月丘から出る";
"line.career.variant.3.meaning" = "人間関係、評価、外部資源に後押しされやすい。";
"line.career.variant.3.observation" = "起点が小指側の下部に寄る。";
"line.career.variant.4.title" = "中ほどで切れる";
"line.career.variant.4.meaning" = "仕事上の役割や責任構造が大きく変わる。";
"line.career.variant.4.observation" = "切れ目が横線で遮られているかを見る。";

"line.sun.title" = "太陽線";
"line.sun.subtitle" = "表現と評価を見る";
"line.sun.summary" = "薬指の下に出る縦線。美意識、作品意識、評価される形を観察する。";
"line.sun.observation" = "薬指下に明瞭な短い縦線があるかを見る。中央の仕事線と混同しない。";
"line.sun.traditional_meaning" = "太陽線は才能の認知、作品の蓄積、審美眼に関係すると読む。";
"line.sun.confusion" = "太陽線は仕事線より短く、薬指下に寄ることが多い。";
"line.sun.tags" = "位置|長さ|明瞭さ|支線";
"line.sun.variant.1.title" = "一本が明瞭";
"line.sun.variant.1.meaning" = "表現が安定し、作品や専門性の評価が積み上がりやすい。";
"line.sun.variant.1.observation" = "薬指下に一本の明瞭な縦線がある。";
"line.sun.variant.2.title" = "細線が複数";
"line.sun.variant.2.meaning" = "興味が広く、表現の経路が多い。";
"line.sun.variant.2.observation" = "細線がまとまって出る。すべての皮膚線を数えない。";
"line.sun.variant.3.title" = "後半が明瞭";
"line.sun.variant.3.meaning" = "後期に個人の作風が固まりやすい。";
"line.sun.variant.3.observation" = "薬指の付け根に近い部分がはっきりする。";
"line.sun.variant.4.title" = "星状紋がある";
"line.sun.variant.4.meaning" = "伝統的には注目される機会の増加と読む。";
"line.sun.variant.4.observation" = "短い線が明瞭に交差していることを確認する。";

"line.marriage.title" = "関係短線";
"line.marriage.subtitle" = "親密関係のリズムを見る";
"line.marriage.summary" = "小指下の手の側面にある短い横線。関係への態度、親密さのリズム、重要な関係の節目を見る。";
"line.marriage.observation" = "小指側を少し曲げると見やすい。主線の数、深さ、方向、分岐を見る。";
"line.marriage.traditional_meaning" = "関係短線は関係の数だけでなく、関係の質、関わり方、親密関係の安定度を見る。";
"line.marriage.confusion" = "関係短線は短く手の側面にある。手のひらを横切る長い線として描かない。";
"line.marriage.tags" = "数|深さ|方向|分岐";
"line.marriage.variant.1.title" = "一本が明瞭";
"line.marriage.variant.1.meaning" = "関係の基準が明確で、投入が集中しやすい。";
"line.marriage.variant.1.observation" = "小指下の側面で一本の主線が最も明瞭。";
"line.marriage.variant.2.title" = "二本が平行";
"line.marriage.variant.2.meaning" = "重要な関係経験が複数、または親密さの課題が複雑。";
"line.marriage.variant.2.observation" = "主線と浅い皮膚線を区別する。";
"line.marriage.variant.3.title" = "終点が上がる";
"line.marriage.variant.3.meaning" = "関係で成長や前向きな支えを重視する。";
"line.marriage.variant.3.observation" = "終点が上がるが、小指の中へは入らない。";
"line.marriage.variant.4.title" = "終点が分かれる";
"line.marriage.variant.4.meaning" = "関係の方向や期待にずれが出やすい。";
"line.marriage.variant.4.observation" = "分岐は短く明瞭で、手の外へ伸びない。";

"path.step.1.title" = "観察の準備";
"path.step.1.action" = "手を清潔にし、自然光か横からの光で観察する。";
"path.step.1.detail" = "写真を残し、左右の手を比べる。手が冷たい、緊張している、運動直後の状態では判断しない。";
"path.step.2.title" = "位置を決める";
"path.step.2.action" = "六大主要線マップで線の位置を見つける。";
"path.step.2.detail" = "まず生命線、知能線、感情線を見る。次に仕事線、太陽線、関係短線を補足する。";
"path.step.3.title" = "変化を読む";
"path.step.3.action" = "深さ、長さ、連続性、分岐の四つで記録する。";
"path.step.3.detail" = "一度に一つの線だけを見る。雑線、皮膚線、関節のしわを主線に混ぜない。";
"path.step.4.title" = "総合判断";
"path.step.4.action" = "左右の手と最近の状態を合わせ、単独で結論を出さない。";
"path.step.4.detail" = "伝統的な解釈は観察の言葉として使う。年齢、仕事、生活リズム、人間関係と合わせて読む。";

"plan.item.1" = "自然光で手の写真を撮る";
