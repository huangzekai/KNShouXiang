"learn.day.detail.goal" = "今日目标";
"learn.day.detail.examples" = "配套图例";
"learn.day.detail.examples.subtitle" = "先看图，再进入单图专业解读。";
"learn.day.detail.practice" = "练习方法";
"learn.day.1.subtitle" = "生命线、智慧线、感情线是入门坐标。";
"learn.day.1.goal" = "先建立手掌坐标感：找到虎口、掌心上区和三条基础主线的位置，暂时不判断结果。";
"learn.day.1.practice" = "在自然光下拍一张掌心照片，用三种颜色标出生命线、智慧线、感情线。只记录起点、走向和是否连续。";
"learn.day.2.subtitle" = "从窄弧、标准弧到阶段变化。";
"learn.day.2.goal" = "理解生命线不等于生命长度线，重点看金星丘包围范围、线体深浅和中段变化。";
"learn.day.2.practice" = "对照三张生命线图例，判断自己的弧度属于窄、标准或宽，再检查是否有明显断续或支线。";
"learn.day.3.subtitle" = "平直、下垂、分叉对应不同思考习惯。";
"learn.day.3.goal" = "掌握智慧线的主轴方向，区分事实型、想象型和双向切换型思考倾向。";
"learn.day.3.practice" = "先找智慧线进入掌心后的走势，再看末端是否向月丘下垂或出现分叉，不把细碎杂纹算作主线。";
"learn.day.4.subtitle" = "起止点、链状、末端变化一起看。";
"learn.day.4.goal" = "把感情线从“感情好坏”的单一判断转为情绪表达、关系标准和敏感度观察。";
"learn.day.4.practice" = "从小指侧往食指侧看感情线，先定终点位置，再判断线体是否平滑、链状或末端分叉。";
"learn.day.5.subtitle" = "目标感要结合起点、断续和掌心中轴。";
"learn.day.5.goal" = "理解事业线不是人人都有，也不代表职业成败；它更适合看责任结构和阶段转换。";
"learn.day.5.practice" = "先找掌心纵线是否存在，再看它从腕部、月丘或生命线附近起步，最后记录中段是否被横线截断。";
"learn.day.6.subtitle" = "短横纹只看关系节奏，不做绝对断语。";
"learn.day.6.goal" = "掌握关系短纹的正确位置：小指下方掌侧短横纹，不能画到掌心，也不能用数量简单推断关系结局。";
"learn.day.6.practice" = "轻轻弯曲小指侧观察掌边，分清主纹和浅皮纹，再看末端上扬、下垂或分叉。";
"learn.day.7.subtitle" = "把太阳线、事业线和情绪线放在同一张图里复查。";
"learn.day.7.goal" = "完成一次专业化表达：位置、形态、传统术语、现代观察、误判边界和观察提示都要出现。";
"learn.day.7.practice" = "任选一个问题，至少引用三张图例写一段观察。结论必须保留边界：单纹只作参考，需结合左右手与近期状态。";
