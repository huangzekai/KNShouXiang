"compass.title" = "观掌";
"compass.subtitle" = "先看位置，再读变化";
"compass.map.title" = "四层观掌地图";
"compass.map.subtitle" = "线、丘、纹、色分开学，避免把所有判断混在一张图里。";
"compass.detail.reading_order" = "阅读顺序";
"compass.lines.title" = "线 · 主线与支线";
"compass.lines.subtitle" = "六条主线先定位，再看深浅、断续、分叉。";
"compass.lines.detail" = "适合入门和复查，是主题前最重要的一层。";
"compass.lines.total_label" = "270 张线相图谱";
"compass.lines.total_body" = "首版按六条主线拆成 52、58、44、46、39、31 个变化位，后续每个变化位都可以配独立图。";
"compass.lines.collection.title" = "六条线索";
"compass.lines.collection.subtitle" = "先记住位置，再进入单线看变化。";
"compass.mounts.title" = "丘 · 掌丘区域";
"compass.mounts.subtitle" = "八大掌丘对应动力、关系、表达和行动倾向。";
"compass.mounts.detail" = "用区域帮助理解线条为什么向某个方向延伸。";
"compass.mounts.item.1.title" = "木星丘";
"compass.mounts.item.1.body" = "位于食指下方，传统上看目标感、主见、荣誉感和带领他人的意愿。";
"compass.mounts.item.2.title" = "金星丘";
"compass.mounts.item.2.body" = "位于拇指根部，常用来观察热情、亲近需求、体力储备和生活温度。";
"compass.mounts.item.3.title" = "月丘";
"compass.mounts.item.3.body" = "位于小指侧下方，和想象、迁移、感受力、公众反馈有关。";
"compass.mounts.item.4.title" = "火星区";
"compass.mounts.item.4.body" = "分布在掌心两侧，常用于观察压力反应、韧性和冲突处理方式。";
"compass.signs.title" = "纹 · 特殊符号";
"compass.signs.subtitle" = "星、十字、岛、三角等符号只作辅助判断。";
"compass.signs.detail" = "符号必须清晰、位置明确，并结合主线和掌丘一起看。";
"compass.signs.item.1.title" = "星纹";
"compass.signs.item.1.body" = "多条短线清楚交会才算星纹，常被用来看突然被看见或事件聚焦。";
"compass.signs.item.2.title" = "十字纹";
"compass.signs.item.2.body" = "两条线明显交叉，解释时要看它压在哪条主线或哪个掌丘上。";
"compass.signs.item.3.title" = "岛纹";
"compass.signs.item.3.body" = "线体形成小环，传统上常表示某段状态被牵制或能量分散。";
"compass.signs.item.4.title" = "三角纹";
"compass.signs.item.4.body" = "三线闭合较清楚才成立，通常作为能力结构或资源汇聚的辅助标记。";
"compass.rhythm.title" = "色 · 节律观察";
"compass.rhythm.subtitle" = "看掌色、弹性和近期状态，不做专业判断。";
"compass.rhythm.detail" = "颜色和纹理会受光线、温度、作息影响，只能做日常观察记录。";
"compass.rhythm.item.1.title" = "掌色";
"compass.rhythm.item.1.body" = "先在自然光下看整体色泽，再比较掌心、指腹和掌丘区域的差异。";
"compass.rhythm.item.2.title" = "深浅";
"compass.rhythm.item.2.body" = "线条突然变浅、变乱时，先记录近期作息和压力，不直接当作定论。";
"compass.rhythm.item.3.title" = "弹性";
"compass.rhythm.item.3.body" = "按压回弹只能作为状态观察，不能替代身体检查或专业建议。";
"compass.rhythm.item.4.title" = "左右手";
"compass.rhythm.item.4.body" = "左右手差异适合长期复看，重点记录变化，而不是一次性判断好坏。";

"ask.title" = "主题";
"ask.subtitle" = "从问题出发，组合看线";
"ask.guide.title" = "先问清楚，再看掌";
"ask.guide.body" = "每次只带一个问题进入：关系、思考、行动或精力。这样读图更清楚，也不会把所有纹路混成一句笼统结论。";
"ask.love.title" = "主题 · 关系表达";
"ask.love.subtitle" = "亲密关系、表达节奏、承诺标准。";
"ask.love.focus" = "先定位感情线，再补看关系短纹";
"ask.thinking.title" = "主题 · 思考方式";
"ask.thinking.subtitle" = "学习、判断、沟通和注意力模式。";
"ask.thinking.focus" = "先定位智慧线，再看它的方向和末端";
"ask.action.title" = "主题 · 行动事业";
"ask.action.subtitle" = "目标感、职业节奏、责任变化。";
"ask.action.focus" = "先看事业线，再补看太阳线和木星丘";
"ask.rhythm.title" = "主题 · 精力节律";
"ask.rhythm.subtitle" = "恢复感、稳定性、近期状态。";
"ask.rhythm.focus" = "先看生命线弧度，再记录掌色和线深";
"ask.detail.focus_title" = "本页先看";
"ask.detail.steps_title" = "四步读法";
"ask.detail.steps_subtitle" = "把观察拆成顺序，避免一眼定性。";
"ask.love.step.1.title" = "找位置";
"ask.love.step.1.body" = "确认感情线是否位于指根下方，关系短纹是否在小指下掌侧短横纹区域。";
"ask.love.step.2.title" = "看末端";
"ask.love.step.2.body" = "感情线末端偏食指、中指或小指侧，会影响传统解释里的关系标准。";
"ask.love.step.3.title" = "看连续";
"ask.love.step.3.body" = "链状、断续、岛纹要和皮肤细纹区分，先放大图再判断。";
"ask.love.step.4.title" = "合并关系节奏";
"ask.love.step.4.body" = "关系短纹只补充亲密节奏，不单独用来判断关系次数或结论。";
"ask.thinking.step.1.title" = "确认主线";
"ask.thinking.step.1.body" = "智慧线从虎口附近进入掌心，通常位于感情线下方。";
"ask.thinking.step.2.title" = "看方向";
"ask.thinking.step.2.body" = "平直偏逻辑，下垂偏想象，分叉表示能在不同表达方式间切换。";
"ask.thinking.step.3.title" = "看起点";
"ask.thinking.step.3.body" = "与生命线同源或分离，常用于观察谨慎程度和独立感。";
"ask.thinking.step.4.title" = "看干扰";
"ask.thinking.step.4.body" = "横切纹、岛纹和细碎支线只作为阶段性干扰，不覆盖主线判断。";
"ask.action.step.1.title" = "找纵线";
"ask.action.step.1.body" = "先找掌心向中指方向上行的事业线，再看无名指下太阳线。";
"ask.action.step.2.title" = "看起点";
"ask.action.step.2.body" = "事业线起于腕部、月丘或生命线附近，代表不同的路径来源。";
"ask.action.step.3.title" = "看阶段";
"ask.action.step.3.body" = "上下段深浅不同，常用于记录方向感何时变强或转换。";
"ask.action.step.4.title" = "看表达";
"ask.action.step.4.body" = "太阳线用于补充作品、审美和被看见的方式，不替代事业线。";
"ask.rhythm.step.1.title" = "看弧度";
"ask.rhythm.step.1.body" = "生命线弧度越开，传统上越重视行动空间和体力调用。";
"ask.rhythm.step.2.title" = "看线深";
"ask.rhythm.step.2.body" = "线深与线色要在自然光下观察，并结合近期作息记录。";
"ask.rhythm.step.3.title" = "看杂纹";
"ask.rhythm.step.3.body" = "细碎纹多时先考虑阶段性压力，不把它当成长期结论。";
"ask.rhythm.step.4.title" = "看复查";
"ask.rhythm.step.4.body" = "同一光线下隔周复拍，比较变化比单次判断更可靠。";

"learn.title" = "七日识掌";
"learn.subtitle" = "每天三张图，从定位到组合判断";
"learn.guide.title" = "先看图，再读法";
"learn.guide.body" = "学径只保留最关键的观察动作：先看配套图例确认位置，再用目标和练习复查，不把单条纹路当成绝对结论。";
"learn.seven_day.title" = "七日识掌";
"learn.seven_day.subtitle" = "由浅入深学习主线、变化、关系与认可线。";
"learn.library.title" = "藏书阁";
"learn.library.subtitle" = "按线法、掌丘、符号、主题路径收藏完整内容。";
"learn.day.1.title" = "第 1 日 · 三线定位";
"learn.day.1.body" = "只找生命线、智慧线、感情线三条主线，拍照并标记位置。";
"learn.day.2.title" = "第 2 日 · 生命线弧度";
"learn.day.2.body" = "比较生命线弧度、深浅和连续性，避免用长短直接判断生命长度。";
"learn.day.3.title" = "第 3 日 · 智慧线方向";
"learn.day.3.body" = "观察智慧线进入掌心后的方向，记录平直、下垂或末端分叉。";
"learn.day.4.title" = "第 4 日 · 感情线分型";
"learn.day.4.body" = "观察感情线终点与线体状态，避免把局部褶皱当成完整分型。";
"learn.day.5.title" = "第 5 日 · 事业线阶段";
"learn.day.5.body" = "查找事业线的起点和连续性，记录职业节奏可能出现的阶段变化。";
"learn.day.6.title" = "第 6 日 · 关系短纹边界";
"learn.day.6.body" = "确认关系短纹位于小指下方掌侧，重点看深浅、方向和主次。";
"learn.day.7.title" = "第 7 日 · 组合复盘";
"learn.day.7.body" = "用一组图例做综合复盘，写出位置、变化、组合和保留判断。";

