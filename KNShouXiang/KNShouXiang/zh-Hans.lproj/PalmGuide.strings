"line.life.title" = "生命线";
"line.life.subtitle" = "看活力与节奏";
"line.life.summary" = "从虎口附近环绕拇指根部向腕部下行，适合观察体力储备、恢复节奏和生活稳定感。";
"line.life.observation" = "先看弧度是否包住金星丘，再看深浅、连续性与末端走向。不要只凭长短判断生命长度。";
"line.life.traditional_meaning" = "生命线在传统手相里偏向体能、行动力和生活根基。深长清晰常被视为气力充足，断续细弱则提示节奏容易被压力打乱。";
"line.life.confusion" = "生命线容易与智慧线起点混在一起，观察时先找到虎口下方的弧形主线。";
"line.life.tags" = "弧度|深浅|断续|末端";
"line.life.variant.1.title" = "深长清晰";
"line.life.variant.1.meaning" = "精力较稳，做事有持续力。";
"line.life.variant.1.observation" = "线体清楚、没有明显断裂，弧度自然包住拇指根。";
"line.life.variant.2.title" = "贴近拇指";
"line.life.variant.2.meaning" = "做事谨慎，体能调动偏保守。";
"line.life.variant.2.observation" = "弧线收得较窄，金星丘空间较小。";
"line.life.variant.3.title" = "中段断续";
"line.life.variant.3.meaning" = "阶段性压力或生活节奏变化明显。";
"line.life.variant.3.observation" = "不要把细小皮肤纹误看成真正断裂，要结合左右手对照。";
"line.life.variant.4.title" = "末端分叉";
"line.life.variant.4.meaning" = "晚阶段活动范围、居住环境或生活重心可能变多。";
"line.life.variant.4.observation" = "看分叉是否清楚、是否向月丘方向延伸。";

"line.head.title" = "智慧线";
"line.head.subtitle" = "看思考方式";
"line.head.summary" = "从虎口附近横穿掌心，是判断分析习惯、学习方式和决策风格的核心主线。";
"line.head.observation" = "先确认它位于感情线下方，再看方向是平直、下垂还是分叉。";
"line.head.traditional_meaning" = "智慧线清楚平稳，传统上多解释为思路有秩序；向下延伸则更偏想象、感受与直觉。";
"line.head.confusion" = "智慧线与生命线同源或分离都常见，关键是看它进入掌心后的走向。";
"line.head.tags" = "方向|长度|起点|分叉";
"line.head.variant.1.title" = "平直有力";
"line.head.variant.1.meaning" = "重逻辑、重事实，适合规则清楚的任务。";
"line.head.variant.1.observation" = "线条横向稳定，末端不明显下坠。";
"line.head.variant.2.title" = "明显下垂";
"line.head.variant.2.meaning" = "想象力强，容易被情境和感受带动。";
"line.head.variant.2.observation" = "末端朝月丘方向走，需与细碎支线区分。";
"line.head.variant.3.title" = "起点分离";
"line.head.variant.3.meaning" = "独立性强，决定来得快。";
"line.head.variant.3.observation" = "智慧线和生命线开端有明显空隙。";
"line.head.variant.4.title" = "末端分叉";
"line.head.variant.4.meaning" = "能在理性与表达之间切换。";
"line.head.variant.4.observation" = "末端分成两支，一支平走，一支略向下。";

"line.heart.title" = "感情线";
"line.heart.subtitle" = "看情绪表达";
"line.heart.summary" = "位于指根下方横向穿过上掌，适合观察情绪表达、亲密关系标准和共情方式。";
"line.heart.observation" = "先看它是否在上掌区稳定横行，再看起止点、弧度、链状纹和分叉。";
"line.heart.traditional_meaning" = "感情线清楚而有弧度，常被解释为情感表达稳定；链状细碎则表示敏感、反应细腻。";
"line.heart.confusion" = "不要把手指根部横纹当成感情线，真正的感情线位于掌面上方。";
"line.heart.tags" = "起点|弧度|链状|分叉";
"line.heart.variant.1.title" = "长达食指下";
"line.heart.variant.1.meaning" = "理想感强，关系中重承诺与价值一致。";
"line.heart.variant.1.observation" = "末端朝食指下方延伸，线体清楚。";
"line.heart.variant.2.title" = "止于中指下";
"line.heart.variant.2.meaning" = "现实克制，表达更含蓄。";
"line.heart.variant.2.observation" = "右端不越掌边，左端停在中指下区域。";
"line.heart.variant.3.title" = "链状细碎";
"line.heart.variant.3.meaning" = "情绪敏感，容易受氛围影响。";
"line.heart.variant.3.observation" = "线体由多个小段组成，不是单条平滑线。";
"line.heart.variant.4.title" = "末端分叉";
"line.heart.variant.4.meaning" = "表达面向多元，能在理性和感受之间切换。";
"line.heart.variant.4.observation" = "末端分支要清楚，避免误判为杂纹。";

"line.career.title" = "事业线";
"line.career.subtitle" = "看目标路径";
"line.career.summary" = "多从掌心下方向中指方向上行，用来观察目标感、职业阶段和外部责任的变化。";
"line.career.observation" = "先看是否有清楚纵线穿过掌心，再看起点来自腕部、月丘还是生命线附近。";
"line.career.traditional_meaning" = "事业线清楚常被解释为目标连续、责任感强；晚起或断续则更像阶段性转换。";
"line.career.confusion" = "事业线不是每个人都明显，没有明显事业线不等于事业差。";
"line.career.tags" = "起点|连续|深浅|阶段";
"line.career.variant.1.title" = "直上中指";
"line.career.variant.1.meaning" = "目标稳定，重长期积累。";
"line.career.variant.1.observation" = "线体靠掌心中轴，上行方向明确。";
"line.career.variant.2.title" = "中年后清晰";
"line.career.variant.2.meaning" = "较晚确定方向，后劲逐渐增强。";
"line.career.variant.2.observation" = "下段弱、上段较深。";
"line.career.variant.3.title" = "来自月丘";
"line.career.variant.3.meaning" = "容易受人际、公众反馈或外部资源推动。";
"line.career.variant.3.observation" = "起点偏小指侧下方。";
"line.career.variant.4.title" = "中段断裂";
"line.career.variant.4.meaning" = "职业身份或责任结构有明显转换。";
"line.career.variant.4.observation" = "观察断点是否被横线截断。";

"line.sun.title" = "太阳线";
"line.sun.subtitle" = "看表达与认可";
"line.sun.summary" = "位于无名指下方的纵向线，适合观察审美表达、作品意识、名望感和被看见的方式。";
"line.sun.observation" = "重点看无名指下是否有清楚短纵线，不要和事业线中轴混淆。";
"line.sun.traditional_meaning" = "太阳线清楚传统上与才华被认可、作品积累和审美品味有关。";
"line.sun.confusion" = "太阳线通常比事业线短，位置更靠无名指下方。";
"line.sun.tags" = "位置|长度|清晰|支线";
"line.sun.variant.1.title" = "清楚单线";
"line.sun.variant.1.meaning" = "表达稳定，作品或专业认可度容易积累。";
"line.sun.variant.1.observation" = "无名指下方有单条清晰纵线。";
"line.sun.variant.2.title" = "多条细线";
"line.sun.variant.2.meaning" = "兴趣广泛，表达渠道多。";
"line.sun.variant.2.observation" = "细线需成组出现，不能把皮肤纹都算进去。";
"line.sun.variant.3.title" = "晚段明显";
"line.sun.variant.3.meaning" = "后期更容易形成个人风格。";
"line.sun.variant.3.observation" = "靠近无名指根部一段较清楚。";
"line.sun.variant.4.title" = "有星状纹";
"line.sun.variant.4.meaning" = "传统上视为被看见的机会增强。";
"line.sun.variant.4.observation" = "星纹必须由短线清楚交会，不是杂乱纹。";

"line.marriage.title" = "关系短纹";
"line.marriage.subtitle" = "看亲密关系节奏";
"line.marriage.summary" = "位于小指下方掌侧的短横纹，更适合看关系态度、亲密节奏和重要关系节点。";
"line.marriage.observation" = "曲起小指侧看会更清楚。先数主纹，再看深浅、方向和分叉。";
"line.marriage.traditional_meaning" = "关系短纹在传统手相中不只看关系数量，更看关系质量、投入方式和亲密关系中的稳定度。";
"line.marriage.confusion" = "关系短纹很短，位置在掌侧，不应画成穿过掌心的大横线。";
"line.marriage.tags" = "数量|深浅|方向|分叉";
"line.marriage.variant.1.title" = "一条清晰";
"line.marriage.variant.1.meaning" = "关系标准明确，投入较集中。";
"line.marriage.variant.1.observation" = "小指下方掌侧有一条主线最明显。";
"line.marriage.variant.2.title" = "两条平行";
"line.marriage.variant.2.meaning" = "重要关系经验不止一次，或亲密议题较复杂。";
"line.marriage.variant.2.observation" = "区分主线和很浅的皮肤细纹。";
"line.marriage.variant.3.title" = "末端上扬";
"line.marriage.variant.3.meaning" = "关系中更看重成长和正向支持。";
"line.marriage.variant.3.observation" = "末端向上但不进入小指。";
"line.marriage.variant.4.title" = "末端分叉";
"line.marriage.variant.4.meaning" = "关系方向或期待容易分歧。";
"line.marriage.variant.4.observation" = "分叉短而清楚，不能延伸到掌外。";

"path.step.1.title" = "观察准备";
"path.step.1.action" = "清洁双手，在自然光或侧光下观察。";
"path.step.1.detail" = "先拍照保存，再对照左右手。不要在手掌紧绷、过冷或刚运动后立刻判断。";
"path.step.2.title" = "先定位置";
"path.step.2.action" = "用六大主线地图找到线的位置。";
"path.step.2.detail" = "先看生命线、智慧线、感情线三条主线，再补充事业线、太阳线、关系短纹。";
"path.step.3.title" = "再读变化";
"path.step.3.action" = "按深浅、长度、连续性、分叉四个维度记录。";
"path.step.3.detail" = "每次只看一条线，避免把杂纹、皮肤纹、指节纹混到主线里。";
"path.step.4.title" = "综合判断";
"path.step.4.action" = "结合左右手和近期状态，不做孤立结论。";
"path.step.4.detail" = "传统解释只能作为观察语言，真正结论要结合年龄、职业、作息和关系处境。";

"plan.item.1" = "拍一张自然光照片";
"plan.item.2" = "标出六条主线位置";
"plan.item.3" = "记录最明显的一条线";
"plan.item.4" = "写下一个容易混淆点";
"plan.item.5" = "隔一周复看变化";

