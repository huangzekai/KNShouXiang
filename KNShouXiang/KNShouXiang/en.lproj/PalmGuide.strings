"line.life.title" = "Life Line";
"line.life.subtitle" = "Vitality and rhythm";
"line.life.summary" = "Runs from the thumb web around the base of the thumb toward the wrist. It helps observe energy, recovery rhythm, and stability.";
"line.life.observation" = "Check whether the curve surrounds the Venus mount, then look at depth, continuity, and ending direction. Do not judge life length by length alone.";
"line.life.traditional_meaning" = "In traditional palmistry, the life line relates to physical energy, action, and life foundation. A deep clear line suggests stable vitality; broken or faint sections suggest disrupted rhythm.";
"line.life.confusion" = "The life line often shares a start with the head line. First find the curved main line below the thumb web.";
"line.life.tags" = "Curve|Depth|Breaks|Ending";
"line.life.variant.1.title" = "Deep and clear";
"line.life.variant.1.meaning" = "Energy is steady, with good persistence.";
"line.life.variant.1.observation" = "The line is clear, not visibly broken, and naturally curves around the thumb base.";
"line.life.variant.2.title" = "Close to thumb";
"line.life.variant.2.meaning" = "Cautious style and conservative use of energy.";
"line.life.variant.2.observation" = "The curve is narrow and the Venus mount area appears smaller.";
"line.life.variant.3.title" = "Broken in middle";
"line.life.variant.3.meaning" = "A period of pressure or life rhythm change is more visible.";
"line.life.variant.3.observation" = "Do not mistake tiny skin creases for a true break. Compare both hands.";
"line.life.variant.4.title" = "Forked ending";
"line.life.variant.4.meaning" = "Later-life activity range, living environment, or focus may broaden.";
"line.life.variant.4.observation" = "Check whether the fork is clear and whether it extends toward the Moon mount.";

"line.head.title" = "Head Line";
"line.head.subtitle" = "Thinking style";
"line.head.summary" = "Crosses the palm from near the thumb web. It is a key line for analysis habits, learning style, and decisions.";
"line.head.observation" = "Confirm it sits below the heart line, then check whether it is straight, downward, or forked.";
"line.head.traditional_meaning" = "A clear steady head line is read as orderly thinking. A downward line suggests imagination, feeling, and intuition.";
"line.head.confusion" = "It may start together with or apart from the life line. The key is its direction after entering the palm.";
"line.head.tags" = "Direction|Length|Start|Fork";
"line.head.variant.1.title" = "Straight and strong";
"line.head.variant.1.meaning" = "Logic and facts matter; structured tasks fit well.";
"line.head.variant.1.observation" = "The line runs steadily across and does not drop sharply at the end.";
"line.head.variant.2.title" = "Clearly downward";
"line.head.variant.2.meaning" = "Imagination is strong and context can affect decisions.";
"line.head.variant.2.observation" = "The end moves toward the Moon mount. Distinguish it from fine branch lines.";
"line.head.variant.3.title" = "Separated start";
"line.head.variant.3.meaning" = "Independence is strong and decisions come quickly.";
"line.head.variant.3.observation" = "There is a clear gap between the head line and life line at the start.";
"line.head.variant.4.title" = "Forked ending";
"line.head.variant.4.meaning" = "Can switch between rational analysis and expression.";
"line.head.variant.4.observation" = "The ending splits into two branches, one horizontal and one slightly downward.";

"line.heart.title" = "Heart Line";
"line.heart.subtitle" = "Emotional expression";
"line.heart.summary" = "Runs across the upper palm below the fingers. It helps observe emotional expression, relationship standards, and empathy.";
"line.heart.observation" = "Check whether it runs steadily across the upper palm, then observe start, end, curve, chain texture, and forks.";
"line.heart.traditional_meaning" = "A clear curved heart line is read as stable emotional expression. A chained fine line suggests sensitivity.";
"line.heart.confusion" = "Do not confuse finger-base creases with the heart line. The true heart line is in the upper palm.";
"line.heart.tags" = "Start|Curve|Chain|Fork";
"line.heart.variant.1.title" = "Long to index finger";
"line.heart.variant.1.meaning" = "Idealistic and values commitment in relationships.";
"line.heart.variant.1.observation" = "The ending extends toward the area below the index finger and remains clear.";
"line.heart.variant.2.title" = "Ends below middle finger";
"line.heart.variant.2.meaning" = "More restrained and realistic in expression.";
"line.heart.variant.2.observation" = "The end does not cross the palm edge and stops below the middle-finger area.";
"line.heart.variant.3.title" = "Chained and fine";
"line.heart.variant.3.meaning" = "Emotionally sensitive and easily affected by atmosphere.";
"line.heart.variant.3.observation" = "The line is made of small connected sections, not one smooth stroke.";
"line.heart.variant.4.title" = "Forked ending";
"line.heart.variant.4.meaning" = "Expression is multifaceted and can shift between reason and feeling.";
"line.heart.variant.4.observation" = "The fork should be clear and not just random fine lines.";

"line.career.title" = "Career Line";
"line.career.subtitle" = "Goal path";
"line.career.summary" = "Usually rises from the lower palm toward the middle finger. It helps observe goals, career stages, and external responsibility.";
"line.career.observation" = "Look for a clear vertical line through the palm, then check whether it starts from the wrist, Moon mount, or near the life line.";
"line.career.traditional_meaning" = "A clear career line suggests steady goals and responsibility. A late-starting or broken line suggests stage changes.";
"line.career.confusion" = "Not everyone has an obvious career line. A faint career line does not mean poor career prospects.";
"line.career.tags" = "Start|Continuity|Depth|Stage";
"line.career.variant.1.title" = "Straight to middle finger";
"line.career.variant.1.meaning" = "Goals are stable and long-term accumulation matters.";
"line.career.variant.1.observation" = "The line sits near the palm center and rises clearly.";
"line.career.variant.2.title" = "Clear after midlife";
"line.career.variant.2.meaning" = "Direction becomes clearer later, with stronger follow-through.";
"line.career.variant.2.observation" = "Lower section is weak; upper section is deeper.";
"line.career.variant.3.title" = "From Moon mount";
"line.career.variant.3.meaning" = "May be pushed by relationships, public feedback, or outside resources.";
"line.career.variant.3.observation" = "The start is lower and closer to the little-finger side.";
"line.career.variant.4.title" = "Broken in middle";
"line.career.variant.4.meaning" = "Work identity or responsibility structure may shift significantly.";
"line.career.variant.4.observation" = "Check whether the break is cut by a horizontal line.";

"line.sun.title" = "Sun Line";
"line.sun.subtitle" = "Expression and recognition";
"line.sun.summary" = "A vertical line below the ring finger. It helps observe aesthetic expression, work consciousness, reputation, and visibility.";
"line.sun.observation" = "Focus on whether a clear short vertical line appears below the ring finger. Do not confuse it with the central career line.";
"line.sun.traditional_meaning" = "The sun line is traditionally linked to recognition of talent, accumulated work, and aesthetic taste.";
"line.sun.confusion" = "It is usually shorter than the career line and sits closer to the ring finger.";
"line.sun.tags" = "Position|Length|Clarity|Branch";
"line.sun.variant.1.title" = "Clear single line";
"line.sun.variant.1.meaning" = "Expression is stable and recognition can accumulate.";
"line.sun.variant.1.observation" = "A single clear vertical line appears below the ring finger.";
"line.sun.variant.2.title" = "Multiple fine lines";
"line.sun.variant.2.meaning" = "Broad interests and multiple channels of expression.";
"line.sun.variant.2.observation" = "Fine lines should appear as a group; do not count every skin crease.";
"line.sun.variant.3.title" = "Clear later segment";
"line.sun.variant.3.meaning" = "Personal style may become clearer later.";
"line.sun.variant.3.observation" = "The section near the ring-finger base is clearer.";
"line.sun.variant.4.title" = "Star mark";
"line.sun.variant.4.meaning" = "Traditionally read as increased chances of being noticed.";
"line.sun.variant.4.observation" = "The star must be formed by clearly crossing short lines.";

"line.marriage.title" = "Relationship Marks";
"line.marriage.subtitle" = "Relationship rhythm";
"line.marriage.summary" = "Short horizontal marks on the palm edge below the little finger. They are better for reading relationship attitude and rhythm than observation alone.";
"line.marriage.observation" = "Bend the little-finger side slightly to see it clearly. Count main lines, then check depth, direction, and forks.";
"line.marriage.traditional_meaning" = "The relationship line is not only about number of relationships. It reflects relationship quality, involvement, and stability.";
"line.marriage.confusion" = "Relationship marks are short and on the palm edge. They should not be drawn as long lines crossing the palm.";
"line.marriage.tags" = "Count|Depth|Direction|Fork";
"line.marriage.variant.1.title" = "One clear line";
"line.marriage.variant.1.meaning" = "Relationship standards are clear and commitment is focused.";
"line.marriage.variant.1.observation" = "One main line is most visible below the little finger on the palm edge.";
"line.marriage.variant.2.title" = "Two parallel lines";
"line.marriage.variant.2.meaning" = "More than one important relationship experience, or complex intimacy issues.";
"line.marriage.variant.2.observation" = "Separate the main line from very shallow skin creases.";
"line.marriage.variant.3.title" = "Ending rises";
"line.marriage.variant.3.meaning" = "Values growth and positive support in relationships.";
"line.marriage.variant.3.observation" = "The ending rises but does not enter the little finger.";
"line.marriage.variant.4.title" = "Forked ending";
"line.marriage.variant.4.meaning" = "Relationship direction or expectations can diverge.";
"line.marriage.variant.4.observation" = "The fork should be short and clear, not extending outside the palm.";

"path.step.1.title" = "Prepare";
"path.step.1.action" = "Clean both hands and observe under natural or side light.";
"path.step.1.detail" = "Take a photo first and compare both hands. Avoid judging when the palm is tense, cold, or right after exercise.";
"path.step.2.title" = "Locate first";
"path.step.2.action" = "Use the six-line map to find each line.";
"path.step.2.detail" = "Start with life, head, and heart lines, then add career, sun, and relationship lines.";
"path.step.3.title" = "Read changes";
"path.step.3.action" = "Record depth, length, continuity, and forks.";
"path.step.3.detail" = "Look at one line at a time. Do not mix random fine lines, skin creases, or finger-joint creases into the main line.";
"path.step.4.title" = "Combine reading";
"path.step.4.action" = "Use both hands and current condition; do not make isolated conclusions.";
"path.step.4.detail" = "Traditional meaning is an observation language. Real reading should consider age, work, routine, and relationships.";

"plan.item.1" = "Take a natural-light photo";
