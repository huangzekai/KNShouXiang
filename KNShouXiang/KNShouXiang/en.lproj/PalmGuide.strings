"gallery.life.position" = "Starts near the thumb web, curves around the thumb base, and descends toward the wrist.";
"gallery.life.observation" = "Check whether the main line is complete, then read the ending branches. Do not count fine skin creases as the main line.";
"gallery.life.reading" = "Life-line changes are traditionally used to observe energy rhythm and life stability.";
"gallery.head.position" = "Enters the palm near the thumb web and often crosses the middle palm horizontally.";
"gallery.head.observation" = "Check whether the start connects with the life line, then read direction, length, and forked endings.";
"gallery.head.reading" = "Head-line changes are used to observe thinking style, learning habits, and decision rhythm.";
"gallery.heart.position" = "Runs across the upper palm below the finger bases.";
"gallery.heart.observation" = "Read the ending point first, then check whether chains, breaks, and forks are clear.";
"gallery.heart.reading" = "Heart-line changes are used for relationship expression, emotional rhythm, and intimacy standards.";
"gallery.career.position" = "Often rises from the wrist or lower palm toward the middle finger.";
"gallery.career.observation" = "Look for a clear vertical line, then read its start, breaks, and crossings.";
"gallery.career.reading" = "Career-line changes are used to observe goal path, responsibility stages, and outside pull.";
"gallery.marriage.position" = "Short horizontal marks on the palm edge below the little finger.";
"gallery.marriage.observation" = "Bend the little-finger side slightly, then count main marks and read depth, direction, and forks.";
"gallery.marriage.reading" = "Relationship marks are better for intimacy rhythm and should not be used alone for conclusions.";
"gallery.sun.position" = "Below the ring finger, often as a short vertical line.";
"gallery.sun.observation" = "Confirm the line sits below the ring finger, then read clarity, length, and branches.";
"gallery.sun.reading" = "Sun-line changes are used to observe expression, work consciousness, and visibility.";
