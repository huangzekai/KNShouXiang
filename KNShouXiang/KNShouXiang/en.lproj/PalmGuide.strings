"learn.day.detail.practice" = "Practice";
"learn.day.1.subtitle" = "Life, head, and heart lines are the entry coordinates.";
"learn.day.1.goal" = "Build palm coordinates first: locate the thumb web, upper palm, and three basic main lines. Do not judge fixed outcome.";
"learn.day.1.practice" = "Photograph the palm in natural light and mark the life, head, and heart lines in three colors. Record only start point, direction, and continuity.";
"learn.day.2.subtitle" = "From narrow arc to standard arc and stage change.";
"learn.day.2.goal" = "Understand that the life line is not a life length line. Focus on how it encloses the Venus mount, its depth, and mid-line changes.";
"learn.day.2.practice" = "Compare the three life-line examples, classify your arc as narrow, standard, or wide, then check for clear breaks or branches.";
"learn.day.3.subtitle" = "Straight, sloping, and forked endings reflect thinking habits.";
"learn.day.3.goal" = "Read the main axis of the head line and separate factual, imaginative, and switching thinking styles.";
"learn.day.3.practice" = "Follow the head line after it enters the palm, then check whether the ending slopes toward the Moon mount or forks. Do not count fine surface lines as the main line.";
"learn.day.4.subtitle" = "Read ending, chain texture, and terminal variants together.";
"learn.day.4.goal" = "Move heart-line reading away from relationship conclusion and toward emotional expression, relationship standards, and sensitivity.";
"learn.day.4.practice" = "Trace the heart line from the little-finger side toward the index side. Locate the ending first, then judge whether the line is smooth, chained, or forked.";
"learn.day.5.subtitle" = "Goal direction needs start point, breaks, and palm axis.";
"learn.day.5.goal" = "Learn that a career line is not visible on every palm and does not equal career success. It is better used for responsibility structure and stage transitions.";
"learn.day.5.practice" = "Look for a vertical line through the palm, note whether it begins near the wrist, Moon mount, or life line, then record any mid-line cut or break.";
"learn.day.6.subtitle" = "Short side lines describe relationship rhythm, not fixed outcomes.";
"learn.day.6.goal" = "Memorize the correct position: short horizontal lines on the palm edge below the little finger. They should not be drawn across the palm or judged by count alone.";
"learn.day.6.practice" = "Gently bend the little-finger side and observe the palm edge. Separate the main line from shallow skin lines, then check upward, downward, or forked endings.";
"learn.day.7.subtitle" = "Review sun, career, and emotional lines in one frame.";
"learn.day.7.goal" = "Complete one reference structure: location, form, traditional terms, modern observation, misread boundary, and observation notes.";
"learn.day.7.practice" = "Choose one question and cite at least three images. Keep the boundary explicit: a single line is reference only and must be combined with both hands and current context.";
