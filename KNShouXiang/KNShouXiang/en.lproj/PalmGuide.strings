"today.card.body" = "Find the end of the heart line first. See whether it lands between the index and middle fingers, or closer to the little-finger side. Observe position before making a conclusion.";
"today.section.continue" = "Continue Learning";
"today.section.continue.subtitle" = "Start from one question, then return to the full atlas for review.";
