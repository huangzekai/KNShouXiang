"compass.title" = "Palm";
"compass.subtitle" = "Locate first, then read change";
"compass.map.title" = "Four-Layer Palm Map";
"compass.map.subtitle" = "Learn lines, mounts, signs, and color separately so every judgment does not collapse into one diagram.";
"compass.detail.reading_order" = "Reading Order";
"compass.lines.title" = "Lines · Main and Branch Lines";
"compass.lines.subtitle" = "Locate the six main lines first, then read depth, breaks, and forks.";
"compass.lines.detail" = "Best for beginners and review. This is the core layer before question-based readings.";
"compass.lines.total_label" = "270 Line Diagrams";
"compass.lines.total_body" = "The first release splits six main lines into 52, 58, 44, 46, 39, and 31 variation slots. Each slot can later receive a dedicated image.";
"compass.lines.collection.title" = "Six Line Tracks";
"compass.lines.collection.subtitle" = "Memorize location first, then enter a single line to read its changes.";
"compass.mounts.title" = "Mounts · Palm Regions";
"compass.mounts.subtitle" = "Eight mounts map motivation, relationships, expression, and action tendencies.";
"compass.mounts.detail" = "Regions explain why a line extends toward a specific direction.";
"compass.mounts.item.1.title" = "Jupiter Mount";
"compass.mounts.item.1.body" = "Below the index finger. Traditionally used for ambition, will, honor, and willingness to lead.";
"compass.mounts.item.2.title" = "Venus Mount";
"compass.mounts.item.2.body" = "At the base of the thumb. Used for warmth, closeness needs, vitality reserve, and life temperature.";
"compass.mounts.item.3.title" = "Moon Mount";
"compass.mounts.item.3.body" = "Lower little-finger side. Connected with imagination, travel, sensitivity, and public response.";
"compass.mounts.item.4.title" = "Mars Areas";
"compass.mounts.item.4.body" = "Across both sides of the palm. Used for pressure response, resilience, and conflict handling.";
"compass.signs.title" = "Signs · Special Marks";
"compass.signs.subtitle" = "Stars, crosses, islands, and triangles are supporting signals only.";
"compass.signs.detail" = "A sign must be clear, well placed, and read together with the main line and mount.";
"compass.signs.item.1.title" = "Star";
"compass.signs.item.1.body" = "Several short lines must meet clearly. Often used for sudden visibility or event focus.";
"compass.signs.item.2.title" = "Cross";
"compass.signs.item.2.body" = "Two clear crossing lines. Interpretation depends on which line or mount it presses on.";
"compass.signs.item.3.title" = "Island";
"compass.signs.item.3.body" = "A small loop formed inside a line. Traditionally read as a restrained phase or dispersed energy.";
"compass.signs.item.4.title" = "Triangle";
"compass.signs.item.4.body" = "Three lines must close clearly. Usually a supporting mark for skill structure or gathered resources.";
"compass.rhythm.title" = "Color · Rhythm Notes";
"compass.rhythm.subtitle" = "Observe palm color, elasticity, and recent state without medical claims.";
"compass.rhythm.detail" = "Color and texture change with light, temperature, and routine. Treat them as daily observation notes.";
"compass.rhythm.item.1.title" = "Palm Color";
"compass.rhythm.item.1.body" = "Check overall tone in natural light, then compare the palm center, fingertips, and mount areas.";
"compass.rhythm.item.2.title" = "Line Depth";
"compass.rhythm.item.2.body" = "When lines suddenly look shallow or messy, record sleep and pressure first instead of making a direct conclusion.";
"compass.rhythm.item.3.title" = "Elasticity";
"compass.rhythm.item.3.body" = "Press-and-release is only a state note. It is not a replacement for medical examination or advice.";
"compass.rhythm.item.4.title" = "Both Hands";
"compass.rhythm.item.4.body" = "Left-right differences are best reviewed over time. Record change rather than judging good or bad at once.";

"ask.title" = "Themes";
"ask.subtitle" = "Start from a question, then combine lines";
"ask.guide.title" = "Clarify the Question First";
"ask.guide.body" = "Bring only one question at a time: relationship, thinking, action, or energy. This keeps the reading specific instead of turning every mark into one vague conclusion.";
"ask.love.title" = "Themes · Relationship Expression";
"ask.love.subtitle" = "Intimacy, expression rhythm, and commitment standards.";
"ask.love.focus" = "Locate the heart line first, then check the relationship line";
"ask.thinking.title" = "Themes · Thinking Style";
"ask.thinking.subtitle" = "Learning, judgment, communication, and attention patterns.";
"ask.thinking.focus" = "Locate the head line first, then read direction and ending";
"ask.action.title" = "Themes · Action and Work";
"ask.action.subtitle" = "Goals, work rhythm, and responsibility changes.";
"ask.action.focus" = "Read the career line first, then add sun line and Jupiter mount";
"ask.rhythm.title" = "Themes · Energy Rhythm";
"ask.rhythm.subtitle" = "Recovery, steadiness, and recent state.";
"ask.rhythm.focus" = "Read the life-line arc, then note palm color and line depth";
"ask.detail.focus_title" = "Read This First";
"ask.detail.steps_title" = "Four-Step Method";
"ask.detail.steps_subtitle" = "Break observation into an order instead of deciding at first glance.";
"ask.love.step.1.title" = "Find Position";
"ask.love.step.1.body" = "Confirm the heart line sits below the finger bases, and the relationship line is a short horizontal mark on the little-finger side.";
"ask.love.step.2.title" = "Read the Ending";
"ask.love.step.2.body" = "Whether the heart line ends toward the index, middle, or little-finger side changes the traditional relationship standard.";
"ask.love.step.3.title" = "Read Continuity";
"ask.love.step.3.body" = "Chains, breaks, and islands must be separated from fine skin lines. Use a larger image before judging.";
"ask.love.step.4.title" = "Combine Relationship Rhythm";
"ask.love.step.4.body" = "The relationship line only supplements intimacy rhythm. Do not use it alone to decide relationship count or outcome.";
"ask.thinking.step.1.title" = "Confirm the Main Line";
"ask.thinking.step.1.body" = "The head line enters the palm near the thumb-index opening and usually sits below the heart line.";
"ask.thinking.step.2.title" = "Read Direction";
"ask.thinking.step.2.body" = "Straight suggests logic, downward suggests imagination, and a fork suggests switching between expression modes.";
"ask.thinking.step.3.title" = "Read the Starting Point";
"ask.thinking.step.3.body" = "Shared or separated origin with the life line helps observe caution and independence.";
"ask.thinking.step.4.title" = "Read Interference";
"ask.thinking.step.4.body" = "Crossing lines, islands, and fine branches are phase-level interference. They do not replace the main-line read.";
"ask.action.step.1.title" = "Find Vertical Lines";
"ask.action.step.1.body" = "Find the career line rising toward the middle finger, then check the sun line below the ring finger.";
"ask.action.step.2.title" = "Read Origin";
"ask.action.step.2.body" = "A career line starting at the wrist, Moon mount, or life-line area suggests different path sources.";
"ask.action.step.3.title" = "Read Stages";
"ask.action.step.3.body" = "Different depth in upper and lower segments helps record when direction strengthens or shifts.";
"ask.action.step.4.title" = "Read Expression";
"ask.action.step.4.body" = "The sun line supplements work, taste, and visibility. It does not replace the career line.";
"ask.rhythm.step.1.title" = "Read the Arc";
"ask.rhythm.step.1.body" = "A wider life-line arc traditionally emphasizes action space and vitality usage.";
"ask.rhythm.step.2.title" = "Read Depth";
"ask.rhythm.step.2.body" = "Observe line depth and color in natural light, then record them with recent routine.";
"ask.rhythm.step.3.title" = "Read Fine Lines";
"ask.rhythm.step.3.body" = "When fine marks are dense, consider phase pressure first rather than treating it as a long-term conclusion.";
"ask.rhythm.step.4.title" = "Review Again";
"ask.rhythm.step.4.body" = "Retake a photo a week later under similar light. Change is more useful than one-time judgment.";

"learn.title" = "Seven-Day Path";
"learn.subtitle" = "Three images a day, from location to combined reading";
"learn.guide.title" = "Look at the Image First";
"learn.guide.body" = "The path keeps only the essential observation moves: confirm location with images, then review with a goal and exercise. A single line is never treated as a final conclusion.";
"learn.seven_day.title" = "Seven-Day Palm Path";
"learn.seven_day.subtitle" = "Move from main lines to variants, relationship lines, and recognition lines.";
"learn.library.title" = "Library";
"learn.library.subtitle" = "Collect line methods, mounts, signs, and question paths in one place.";
"learn.day.1.title" = "Day 1 · Locate Three Lines";
"learn.day.1.body" = "Find only the life, head, and heart lines. Take a photo and mark positions.";
"learn.day.2.title" = "Day 2 · Life Line Arc";
"learn.day.2.body" = "Compare life-line arc, depth, and continuity. Do not read life length from length.";
"learn.day.3.title" = "Day 3 · Head Line Direction";
"learn.day.3.body" = "Observe the head line after it enters the palm and record straight, sloping, or forked endings.";
"learn.day.4.title" = "Day 4 · Heart Line Types";
"learn.day.4.body" = "Observe heart-line ending and texture. Do not treat local creases as a full type.";
"learn.day.5.title" = "Day 5 · Career Line Stages";
"learn.day.5.body" = "Find the career line start and continuity, then record possible stage changes in work rhythm.";
"learn.day.6.title" = "Day 6 · Relationship Marks Boundary";
"learn.day.6.body" = "Confirm the relationship line sits on the palm edge below the little finger. Focus on depth, direction, and hierarchy.";
"learn.day.7.title" = "Day 7 · Combined Review";
"learn.day.7.body" = "Use a set of images for a combined review: position, variation, combination, and reserved judgment.";

