"line.life.title" = "生命線";
"line.life.subtitle" = "看活力與節奏";
"line.life.summary" = "從虎口附近環繞拇指根部向腕部下行，適合觀察體力儲備、恢復節奏和生活穩定感。";
"line.life.observation" = "先看弧度是否包住金星丘，再看深淺、連續性與末端走向。不要只憑長短判斷壽命。";
"line.life.traditional_meaning" = "生命線在傳統手相裡偏向體能、行動力和生活根基。深長清晰常被視為氣力充足，斷續細弱則提示節奏容易被壓力打亂。";
"line.life.confusion" = "生命線容易與智慧線起點混在一起，觀察時先找到虎口下方的弧形主線。";
"line.life.tags" = "弧度|深淺|斷續|末端";
"line.life.variant.1.title" = "深長清晰";
"line.life.variant.1.meaning" = "精力較穩，做事有持續力。";
"line.life.variant.1.observation" = "線體清楚、沒有明顯斷裂，弧度自然包住拇指根。";
"line.life.variant.2.title" = "貼近拇指";
"line.life.variant.2.meaning" = "做事謹慎，體能調動偏保守。";
"line.life.variant.2.observation" = "弧線收得較窄，金星丘空間較小。";
"line.life.variant.3.title" = "中段斷續";
"line.life.variant.3.meaning" = "階段性壓力或生活節奏變化明顯。";
"line.life.variant.3.observation" = "不要把細小皮膚紋誤看成真正斷裂，要結合左右手對照。";
"line.life.variant.4.title" = "末端分叉";
"line.life.variant.4.meaning" = "晚階段活動範圍、居住環境或生活重心可能變多。";
"line.life.variant.4.observation" = "看分叉是否清楚、是否向月丘方向延伸。";

"line.head.title" = "智慧線";
"line.head.subtitle" = "看思考方式";
"line.head.summary" = "從虎口附近橫穿掌心，是判斷分析習慣、學習方式和決策風格的核心主線。";
"line.head.observation" = "先確認它位於感情線下方，再看方向是平直、下垂還是分叉。";
"line.head.traditional_meaning" = "智慧線清楚平穩，傳統上多解釋為思路有秩序；向下延伸則更偏想像、感受與直覺。";
"line.head.confusion" = "智慧線與生命線同源或分離都常見，關鍵是看它進入掌心後的走向。";
"line.head.tags" = "方向|長度|起點|分叉";
"line.head.variant.1.title" = "平直有力";
"line.head.variant.1.meaning" = "重邏輯、重事實，適合規則清楚的任務。";
"line.head.variant.1.observation" = "線條橫向穩定，末端不明顯下墜。";
"line.head.variant.2.title" = "明顯下垂";
"line.head.variant.2.meaning" = "想像力強，容易被情境和感受帶動。";
"line.head.variant.2.observation" = "末端朝月丘方向走，需與細碎支線區分。";
"line.head.variant.3.title" = "起點分離";
"line.head.variant.3.meaning" = "獨立性強，決定來得快。";
"line.head.variant.3.observation" = "智慧線和生命線開端有明顯空隙。";
"line.head.variant.4.title" = "末端分叉";
"line.head.variant.4.meaning" = "能在理性與表達之間切換。";
"line.head.variant.4.observation" = "末端分成兩支，一支平走，一支略向下。";

"line.heart.title" = "感情線";
"line.heart.subtitle" = "看情緒表達";
"line.heart.summary" = "位於指根下方橫向穿過上掌，適合觀察情緒表達、親密關係標準和共情方式。";
"line.heart.observation" = "先看它是否在上掌區穩定橫行，再看起止點、弧度、鏈狀紋和分叉。";
"line.heart.traditional_meaning" = "感情線清楚而有弧度，常被解釋為情感表達穩定；鏈狀細碎則表示敏感、反應細膩。";
"line.heart.confusion" = "不要把手指根部橫紋當成感情線，真正的感情線位於掌面上方。";
"line.heart.tags" = "起點|弧度|鏈狀|分叉";
"line.heart.variant.1.title" = "長達食指下";
"line.heart.variant.1.meaning" = "理想感強，關係中重承諾與價值一致。";
"line.heart.variant.1.observation" = "末端朝食指下方延伸，線體清楚。";
"line.heart.variant.2.title" = "止於中指下";
"line.heart.variant.2.meaning" = "現實克制，表達更含蓄。";
"line.heart.variant.2.observation" = "右端不越掌邊，左端停在中指下區域。";
"line.heart.variant.3.title" = "鏈狀細碎";
"line.heart.variant.3.meaning" = "情緒敏感，容易受氛圍影響。";
"line.heart.variant.3.observation" = "線體由多個小段組成，不是單條平滑線。";
"line.heart.variant.4.title" = "末端分叉";
"line.heart.variant.4.meaning" = "表達面向多元，能在理性和感受之間切換。";
"line.heart.variant.4.observation" = "末端分支要清楚，避免誤判為雜紋。";

"line.career.title" = "事業線";
"line.career.subtitle" = "看目標路徑";
"line.career.summary" = "多從掌心下方向中指方向上行，用來觀察目標感、職業階段和外部責任的變化。";
"line.career.observation" = "先看是否有清楚縱線穿過掌心，再看起點來自腕部、月丘還是生命線附近。";
"line.career.traditional_meaning" = "事業線清楚常被解釋為目標連續、責任感強；晚起或斷續則更像階段性轉換。";
"line.career.confusion" = "事業線不是每個人都明顯，沒有明顯事業線不等於事業差。";
"line.career.tags" = "起點|連續|深淺|階段";
"line.career.variant.1.title" = "直上中指";
"line.career.variant.1.meaning" = "目標穩定，重長期積累。";
"line.career.variant.1.observation" = "線體靠掌心中軸，上行方向明確。";
"line.career.variant.2.title" = "中年後清晰";
"line.career.variant.2.meaning" = "較晚確定方向，後勁逐漸增強。";
"line.career.variant.2.observation" = "下段弱、上段較深。";
"line.career.variant.3.title" = "來自月丘";
"line.career.variant.3.meaning" = "容易受人際、公眾回饋或外部資源推動。";
"line.career.variant.3.observation" = "起點偏小指側下方。";
"line.career.variant.4.title" = "中段斷裂";
"line.career.variant.4.meaning" = "職業身份或責任結構有明顯轉換。";
"line.career.variant.4.observation" = "觀察斷點是否被橫線截斷。";

"line.sun.title" = "太陽線";
"line.sun.subtitle" = "看表達與認可";
"line.sun.summary" = "位於無名指下方的縱向線，適合觀察審美表達、作品意識、名望感和被看見的方式。";
"line.sun.observation" = "重點看無名指下是否有清楚短縱線，不要和事業線中軸混淆。";
"line.sun.traditional_meaning" = "太陽線清楚傳統上與才華被認可、作品積累和審美品味有關。";
"line.sun.confusion" = "太陽線通常比事業線短，位置更靠無名指下方。";
"line.sun.tags" = "位置|長度|清晰|支線";
"line.sun.variant.1.title" = "清楚單線";
"line.sun.variant.1.meaning" = "表達穩定，作品或專業認可度容易積累。";
"line.sun.variant.1.observation" = "無名指下方有單條清晰縱線。";
"line.sun.variant.2.title" = "多條細線";
"line.sun.variant.2.meaning" = "興趣廣泛，表達渠道多。";
"line.sun.variant.2.observation" = "細線需成組出現，不能把皮膚紋都算進去。";
"line.sun.variant.3.title" = "晚段明顯";
"line.sun.variant.3.meaning" = "後期更容易形成個人風格。";
"line.sun.variant.3.observation" = "靠近無名指根部一段較清楚。";
"line.sun.variant.4.title" = "有星狀紋";
"line.sun.variant.4.meaning" = "傳統上視為被看見的機會增強。";
"line.sun.variant.4.observation" = "星紋必須由短線清楚交會，不是雜亂紋。";

"line.marriage.title" = "婚姻線";
"line.marriage.subtitle" = "看親密關係節奏";
"line.marriage.summary" = "位於小指下方掌側的短橫紋，更適合看關係態度、親密節奏和重要關係節點。";
"line.marriage.observation" = "曲起小指側看會更清楚。先數主紋，再看深淺、方向和分叉。";
"line.marriage.traditional_meaning" = "婚姻線在傳統手相中不只看婚姻數量，更看關係品質、投入方式和親密關係中的穩定度。";
"line.marriage.confusion" = "婚姻線很短，位置在掌側，不應畫成穿過掌心的大橫線。";
"line.marriage.tags" = "數量|深淺|方向|分叉";
"line.marriage.variant.1.title" = "一條清晰";
"line.marriage.variant.1.meaning" = "關係標準明確，投入較集中。";
"line.marriage.variant.1.observation" = "小指下方掌側有一條主線最明顯。";
"line.marriage.variant.2.title" = "兩條平行";
"line.marriage.variant.2.meaning" = "重要關係經驗不止一次，或親密議題較複雜。";
"line.marriage.variant.2.observation" = "區分主線和很淺的皮膚細紋。";
"line.marriage.variant.3.title" = "末端上揚";
"line.marriage.variant.3.meaning" = "關係中更看重成長和正向支持。";
"line.marriage.variant.3.observation" = "末端向上但不進入小指。";
"line.marriage.variant.4.title" = "末端分叉";
"line.marriage.variant.4.meaning" = "關係方向或期待容易分歧。";
"line.marriage.variant.4.observation" = "分叉短而清楚，不能延伸到掌外。";

"path.step.1.title" = "觀察準備";
"path.step.1.action" = "清潔雙手，在自然光或側光下觀察。";
"path.step.1.detail" = "先拍照保存，再對照左右手。不要在手掌緊繃、過冷或剛運動後立刻判斷。";
"path.step.2.title" = "先定位置";
"path.step.2.action" = "用六大主線地圖找到線的位置。";
"path.step.2.detail" = "先看生命線、智慧線、感情線三條主線，再補充事業線、太陽線、婚姻線。";
"path.step.3.title" = "再讀變化";
"path.step.3.action" = "按深淺、長度、連續性、分叉四個維度記錄。";
"path.step.3.detail" = "每次只看一條線，避免把雜紋、皮膚紋、指節紋混到主線裡。";
"path.step.4.title" = "綜合判斷";
"path.step.4.action" = "結合左右手和近期狀態，不做孤立結論。";
"path.step.4.detail" = "傳統解釋只能作為觀察語言，真正結論要結合年齡、職業、作息和關係處境。";

"plan.item.1" = "拍一張自然光照片";
"plan.item.2" = "標出六條主線位置";
"plan.item.3" = "記錄最明顯的一條線";
"plan.item.4" = "寫下一個容易混淆點";
"plan.item.5" = "隔一週複看變化";

