"compass.title" = "觀掌";
"compass.subtitle" = "先看位置，再讀變化";
"compass.map.title" = "四層觀掌地圖";
"compass.map.subtitle" = "線、丘、紋、色分開學，避免把所有判斷混在一張圖裡。";
"compass.detail.reading_order" = "閱讀順序";
"compass.lines.title" = "線 · 主線與支線";
"compass.lines.subtitle" = "六條主線先定位，再看深淺、斷續、分叉。";
"compass.lines.detail" = "適合入門和複查，是問事前最重要的一層。";
"compass.lines.total_label" = "270 張線相圖譜";
"compass.lines.total_body" = "首版按六條主線拆成 52、58、44、46、39、31 個變化位，後續每個變化位都可以配獨立圖。";
"compass.lines.collection.title" = "六條線索";
"compass.lines.collection.subtitle" = "先記住位置，再進入單線看變化。";
"compass.mounts.title" = "丘 · 掌丘區域";
"compass.mounts.subtitle" = "八大掌丘對應動力、關係、表達和行動傾向。";
"compass.mounts.detail" = "用區域幫助理解線條為什麼向某個方向延伸。";
"compass.mounts.item.1.title" = "木星丘";
"compass.mounts.item.1.body" = "位於食指下方，傳統上看目標感、主見、榮譽感和帶領他人的意願。";
"compass.mounts.item.2.title" = "金星丘";
"compass.mounts.item.2.body" = "位於拇指根部，常用來觀察熱情、親近需求、體力儲備和生活溫度。";
"compass.mounts.item.3.title" = "月丘";
"compass.mounts.item.3.body" = "位於小指側下方，和想像、遷移、感受力、公共回饋有關。";
"compass.mounts.item.4.title" = "火星區";
"compass.mounts.item.4.body" = "分布在掌心兩側，常用於觀察壓力反應、韌性和衝突處理方式。";
"compass.signs.title" = "紋 · 特殊符號";
"compass.signs.subtitle" = "星、十字、島、三角等符號只作輔助判斷。";
"compass.signs.detail" = "符號必須清晰、位置明確，並結合主線和掌丘一起看。";
"compass.signs.item.1.title" = "星紋";
"compass.signs.item.1.body" = "多條短線清楚交會才算星紋，常被用來看突然被看見或事件聚焦。";
"compass.signs.item.2.title" = "十字紋";
"compass.signs.item.2.body" = "兩條線明顯交叉，解釋時要看它壓在哪條主線或哪個掌丘上。";
"compass.signs.item.3.title" = "島紋";
"compass.signs.item.3.body" = "線體形成小環，傳統上常表示某段狀態被牽制或能量分散。";
"compass.signs.item.4.title" = "三角紋";
"compass.signs.item.4.body" = "三線閉合較清楚才成立，通常作為能力結構或資源匯聚的輔助標記。";
"compass.rhythm.title" = "色 · 節律觀察";
"compass.rhythm.subtitle" = "看掌色、彈性和近期狀態，不做醫療判斷。";
"compass.rhythm.detail" = "顏色和紋理會受光線、溫度、作息影響，只能做日常觀察記錄。";
"compass.rhythm.item.1.title" = "掌色";
"compass.rhythm.item.1.body" = "先在自然光下看整體色澤，再比較掌心、指腹和掌丘區域的差異。";
"compass.rhythm.item.2.title" = "深淺";
"compass.rhythm.item.2.body" = "線條突然變淺、變亂時，先記錄近期作息和壓力，不直接當作定論。";
"compass.rhythm.item.3.title" = "彈性";
"compass.rhythm.item.3.body" = "按壓回彈只能作為狀態觀察，不能替代身體檢查或醫學建議。";
"compass.rhythm.item.4.title" = "左右手";
"compass.rhythm.item.4.body" = "左右手差異適合長期複看，重點記錄變化，而不是一次性判斷好壞。";

"ask.title" = "問事";
"ask.subtitle" = "從問題出發，組合看線";
"ask.guide.title" = "先問清楚，再看掌";
"ask.guide.body" = "每次只帶一個問題進入：關係、思考、行動或精力。這樣讀圖更清楚，也不會把所有紋路混成一句籠統結論。";
"ask.love.title" = "問事 · 關係表達";
"ask.love.subtitle" = "親密關係、表達節奏、承諾標準。";
"ask.love.focus" = "先定位感情線，再補看婚姻線";
"ask.thinking.title" = "問事 · 思考方式";
"ask.thinking.subtitle" = "學習、判斷、溝通和注意力模式。";
"ask.thinking.focus" = "先定位智慧線，再看它的方向和末端";
"ask.action.title" = "問事 · 行動事業";
"ask.action.subtitle" = "目標感、職業節奏、責任變化。";
"ask.action.focus" = "先看事業線，再補看太陽線和木星丘";
"ask.rhythm.title" = "問事 · 精力節律";
"ask.rhythm.subtitle" = "恢復感、穩定性、近期狀態。";
"ask.rhythm.focus" = "先看生命線弧度，再記錄掌色和線深";
"ask.detail.focus_title" = "本頁先看";
"ask.detail.steps_title" = "四步讀法";
"ask.detail.steps_subtitle" = "把觀察拆成順序，避免一眼定性。";
"ask.love.step.1.title" = "找位置";
"ask.love.step.1.body" = "確認感情線是否位於指根下方，婚姻線是否在小指下掌側短橫紋區域。";
"ask.love.step.2.title" = "看末端";
"ask.love.step.2.body" = "感情線末端偏食指、中指或小指側，會影響傳統解釋裡的關係標準。";
"ask.love.step.3.title" = "看連續";
"ask.love.step.3.body" = "鏈狀、斷續、島紋要和皮膚細紋區分，先放大圖再判斷。";
"ask.love.step.4.title" = "合併關係節奏";
"ask.love.step.4.body" = "婚姻線只補充親密節奏，不單獨用來判斷婚姻次數或結論。";
"ask.thinking.step.1.title" = "確認主線";
"ask.thinking.step.1.body" = "智慧線從虎口附近進入掌心，通常位於感情線下方。";
"ask.thinking.step.2.title" = "看方向";
"ask.thinking.step.2.body" = "平直偏邏輯，下垂偏想像，分叉表示能在不同表達方式間切換。";
"ask.thinking.step.3.title" = "看起點";
"ask.thinking.step.3.body" = "與生命線同源或分離，常用於觀察謹慎程度和獨立感。";
"ask.thinking.step.4.title" = "看干擾";
"ask.thinking.step.4.body" = "橫切紋、島紋和細碎支線只作為階段性干擾，不覆蓋主線判斷。";
"ask.action.step.1.title" = "找縱線";
"ask.action.step.1.body" = "先找掌心向中指方向上行的事業線，再看無名指下太陽線。";
"ask.action.step.2.title" = "看起點";
"ask.action.step.2.body" = "事業線起於腕部、月丘或生命線附近，代表不同的路徑來源。";
"ask.action.step.3.title" = "看階段";
"ask.action.step.3.body" = "上下段深淺不同，常用於記錄方向感何時變強或轉換。";
"ask.action.step.4.title" = "看表達";
"ask.action.step.4.body" = "太陽線用於補充作品、審美和被看見的方式，不替代事業線。";
"ask.rhythm.step.1.title" = "看弧度";
"ask.rhythm.step.1.body" = "生命線弧度越開，傳統上越重視行動空間和體力調用。";
"ask.rhythm.step.2.title" = "看線深";
"ask.rhythm.step.2.body" = "線深與線色要在自然光下觀察，並結合近期作息記錄。";
"ask.rhythm.step.3.title" = "看雜紋";
"ask.rhythm.step.3.body" = "細碎紋多時先考慮階段性壓力，不把它當成長期結論。";
"ask.rhythm.step.4.title" = "看複查";
"ask.rhythm.step.4.body" = "同一光線下隔週複拍，比較變化比單次判斷更可靠。";

"learn.title" = "七日識掌";
"learn.subtitle" = "每天三張圖，從定位到組合判斷";
"learn.guide.title" = "先看圖，再讀法";
"learn.guide.body" = "學徑只保留最關鍵的觀察動作：先看配套圖例確認位置，再用目標和練習複查，不把單條紋路當成絕對結論。";
"learn.seven_day.title" = "七日識掌";
"learn.seven_day.subtitle" = "由淺入深學習主線、變化、關係與認可線。";
"learn.library.title" = "藏書閣";
"learn.library.subtitle" = "按線法、掌丘、符號、問事路徑收藏完整內容。";
"learn.day.1.title" = "第 1 日 · 三線定位";
"learn.day.1.body" = "只找生命線、智慧線、感情線三條主線，拍照並標記位置。";
"learn.day.2.title" = "第 2 日 · 生命線弧度";
"learn.day.2.body" = "比較生命線弧度、深淺和連續性，避免用長短直接判斷壽命。";
"learn.day.3.title" = "第 3 日 · 智慧線方向";
"learn.day.3.body" = "觀察智慧線進入掌心後的方向，記錄平直、下垂或末端分叉。";
"learn.day.4.title" = "第 4 日 · 感情線分型";
"learn.day.4.body" = "觀察感情線終點與線體狀態，避免把局部褶皺當成完整分型。";
"learn.day.5.title" = "第 5 日 · 事業線階段";
"learn.day.5.body" = "查找事業線的起點和連續性，記錄職業節奏可能出現的階段變化。";
"learn.day.6.title" = "第 6 日 · 婚姻線邊界";
"learn.day.6.body" = "確認婚姻線位於小指下方掌側，重點看深淺、方向和主次。";
"learn.day.7.title" = "第 7 日 · 組合複盤";
"learn.day.7.body" = "用一組圖例做綜合複盤，寫出位置、變化、組合和保留判斷。";

