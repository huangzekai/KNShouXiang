"learn.day.examples_format" = "%d 張配套圖例";
"learn.day.detail.goal" = "今日目標";
"learn.day.detail.examples" = "配套圖例";
"learn.day.detail.examples.subtitle" = "先看圖，再進入單圖專業解讀。";
"learn.day.detail.practice" = "練習方法";
"learn.day.1.subtitle" = "生命線、智慧線、感情線是入門座標。";
"learn.day.1.goal" = "先建立手掌座標感：找到虎口、掌心上區和三條基礎主線的位置，暫時不判斷吉凶。";
"learn.day.1.practice" = "在自然光下拍一張掌心照片，用三種顏色標出生命線、智慧線、感情線。只記錄起點、走向和是否連續。";
"learn.day.2.subtitle" = "從窄弧、標準弧到階段變化。";
"learn.day.2.goal" = "理解生命線不等於壽命線，重點看金星丘包圍範圍、線體深淺和中段變化。";
"learn.day.2.practice" = "對照三張生命線圖例，判斷自己的弧度屬於窄、標準或寬，再檢查是否有明顯斷續或支線。";
"learn.day.3.subtitle" = "平直、下垂、分叉對應不同思考習慣。";
"learn.day.3.goal" = "掌握智慧線的主軸方向，區分事實型、想像型和雙向切換型思考傾向。";
"learn.day.3.practice" = "先找智慧線進入掌心後的走勢，再看末端是否向月丘下垂或出現分叉，不把細碎雜紋算作主線。";
"learn.day.4.subtitle" = "起止點、鏈狀、末端變化一起看。";
"learn.day.4.goal" = "把感情線從「感情好壞」的單一判斷轉為情緒表達、關係標準和敏感度觀察。";
"learn.day.4.practice" = "從小指側往食指側看感情線，先定終點位置，再判斷線體是否平滑、鏈狀或末端分叉。";
"learn.day.5.subtitle" = "目標感要結合起點、斷續和掌心中軸。";
"learn.day.5.goal" = "理解事業線不是人人都有，也不代表職業成敗；它更適合看責任結構和階段轉換。";
"learn.day.5.practice" = "先找掌心縱線是否存在，再看它從腕部、月丘或生命線附近起步，最後記錄中段是否被橫線截斷。";
"learn.day.6.subtitle" = "短橫紋只看關係節奏，不做絕對斷語。";
"learn.day.6.goal" = "掌握婚姻線的正確位置：小指下方掌側短橫紋，不能畫到掌心，也不能用數量簡單推斷關係結局。";
"learn.day.6.practice" = "輕輕彎曲小指側觀察掌邊，分清主紋和淺皮紋，再看末端上揚、下垂或分叉。";
"learn.day.7.subtitle" = "把太陽線、事業線和情緒線放在同一張圖裡複查。";
"learn.day.7.goal" = "完成一次專業化表達：位置、形態、傳統釋義、現代轉譯、誤判邊界和行動建議都要出現。";
"learn.day.7.practice" = "任選一個問題，至少引用三張圖例寫一段觀察。結論必須保留邊界：單紋只作參考，需結合左右手與近期狀態。";
